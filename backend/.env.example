# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Logging (pino level: trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins.
# Defaults to localhost dev origins when unset. Use "*" to allow any origin.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Neon Postgres connection string (optional until the Drizzle-backed repo lands;
# required for drizzle-kit commands)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/fretspace?sslmode=require
